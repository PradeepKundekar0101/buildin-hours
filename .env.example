# ---- Sarvam (required) ----
SARVAM_API_KEY=

# ---- Twilio (required for PSTN; sim transport works without) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Public https base of the orchestrator, used for TwiML + media stream URLs.
# Local dev: run `ngrok http 8080` and paste the https URL here.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Discovery (optional; seed CSV works without) ----
GOOGLE_PLACES_API_KEY=

# ---- Engine tuning ----
PORT=8080
MAX_PARALLEL_CALLS=6
# bulbul:v3 (30+ voices, dict_id) or bulbul:v2 (7 voices, cached responses)
TTS_MODEL=bulbul:v3
# Chat models. Measured against the live API on 9 Aug 2026:
#   sarvam-m                   deprecated, returns 400
#   sarvam-105b                reasoning model - spends its whole budget thinking
#                              and returns null content at phone-call token caps
#   sarvam-105b-conversations  ~2s, valid JSON, finish_reason "stop"  <- use this
NEGOTIATE_MODEL=sarvam-105b-conversations
FAST_MODEL=sarvam-105b-conversations
# Set to 1 to force batch STT + local endpointing instead of the realtime socket.
FALLBACK_VAD=0
# Set to 1 to allow calls outside the 9:00-20:30 IST window (demos/rehearsal).
IGNORE_CALL_WINDOW=0

# ---- Test mode ----
# Rehearse against real telephony without calling a single shop: every call keeps
# its counterparty's name, language, and persona but rings this number instead, one
# at a time, so you can answer and play the shopkeeper. Test missions are tagged and
# excluded from the public savings counter and the Bhav Index.
# This is also the only way to place a real PSTN call on a Twilio trial account,
# which can only dial numbers you have verified.
TEST_CALL_REDIRECT=+917411420401
# Set to 1 to make every mission a test mission unless it explicitly opts out.
TEST_MODE=0
# How many counterparties a test mission actually rings. Raise to 2 to rehearse the
# cross-call leverage beat, which needs a second quote on the bus before it fires.
TEST_CALL_COUNT=1

# ---- Web ----
NEXT_PUBLIC_API_BASE=http://localhost:8080
